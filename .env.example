# 复制为 .env；make 会加载该文件。首次执行 make init 生成证券演示库。
SQLITE_PATH=data/securities_demo.sqlite3
QUERY_TIMEOUT=10s
REWRITE_CONFIG=config/rewrite.yml
REWRITE_AS_OF=2026-10-21T00:00:00Z

# MCP 身份：oauth（默认）| header（可信网关）| none（显式默认员工）
MCP_AUTH_MODE=oauth
MCP_USER_HEADER=X-User-Id
MCP_DEFAULT_USER_ID=
MCP_TRANSPORT=http
SERVER_ADDR=127.0.0.1:8080
MCP_PATH=/mcp
MCP_RESOURCE_URL=http://127.0.0.1:8080/mcp
MCP_STATELESS=true
# true 时返回改写 SQL / binds，开放需管理员权限的 raw_query / customer_scope
MCP_DEBUG=true

# OAuth 授权服务器位于 admin-api。外部接入时 issuer/resource 必须是客户端可达 HTTPS 地址。
OAUTH_ISSUER=http://127.0.0.1:8081
# 必填：统一演示明文密码（非密文/哈希），至少 12 字符；实际项目需替换为正式员工认证。
OAUTH_DEMO_PASSWORD=
# 仅本地演示时开启，无密码直接模拟员工登录；默认关闭
OAUTH_DEBUG_LOGIN=false
# 私钥和 OAuth 状态为本地私密文件，不提交 git；重启可保留注册与刷新令牌
OAUTH_KEY_PATH=data/oauth/signing.pem
OAUTH_STATE_PATH=data/oauth/state.sqlite3

ADMIN_API_ADDR=127.0.0.1:8081
MCP_SERVER_URL=http://127.0.0.1:8080/mcp
FIXTURES_DIR=fixtures
WEB_PORT=8082
ADMIN_API_URL=http://127.0.0.1:8081
